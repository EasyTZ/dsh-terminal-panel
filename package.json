{
  "name": "@easytz/dsh-terminal-panel",
  "version": "0.2.0",
  "description": "Terminal panel: run commands in the current workspace with streaming output, tabs, and Ctrl+C",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "^0.1.1-rc.2"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "terminal",
    "shell",
    "sidebar-panel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EasyTZ/dsh-terminal-panel.git"
  },
  "homepage": "https://github.com/EasyTZ/dsh-terminal-panel#readme",
  "bugs": {
    "url": "https://github.com/EasyTZ/dsh-terminal-panel/issues"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}
